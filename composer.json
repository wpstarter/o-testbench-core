{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "wpstarter/o-testbench-core",
    "description": "Testing Helper for Laravel Development",
    "homepage": "https://packages.tools/testbench",
    "keywords": ["laravel", "laravel-packages", "testing", "tdd", "bdd", "dev"],
    "license": "MIT",
    "support": {
        "issues": "https://github.com/orchestral/testbench/issues",
        "source": "https://github.com/orchestral/testbench-core"
    },
    "authors": [
        {
            "name": "Mior Muhammad Zaki",
            "email": "crynobone@gmail.com",
            "homepage": "https://github.com/crynobone"
        }
    ],
    "autoload": {
        "psr-4": {
            "Orchestra\\Testbench\\": "src/",
            "Orchestra\\Sidekick\\": "lib/sidekick/src"
        },
        "files": [
            "src/functions.php",
            "lib/sidekick/src/Eloquent/functions.php",
            "lib/sidekick/src/Filesystem/functions.php",
            "lib/sidekick/src/Http/functions.php",
            "lib/sidekick/src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Orchestra\\Testbench\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "bin": [
        "testbench"
    ],
    "require": {
        "php": "^8.2",
        "composer/semver": "^3.0",
        "composer-runtime-api": "^2.2",
        "symfony/deprecation-contracts": "^2.5|^3.0",
        "symfony/polyfill-php83": "^1.33"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "wpstarter/framework": "^2.0",
        "mockery/mockery": "^1.6.10",
        "phpstan/phpstan": "2.2.16",
        "phpunit/phpunit": "^10.5.35|^11.5.3|^12.0.1|^13.0.0",
        "symfony/process": "^7.2.0",
        "symfony/yaml": "^7.2.0",
        "vlucas/phpdotenv": "^5.6.1"
    },
    "conflict": {
        "phpunit/phpunit": "<10.5.35|>=11.0.0 <11.5.3|12.0.0|>=13.2.0"
    },
    "suggest": {

    },
    "config": {
        "audit": {
            "block-insecure": true,
            "ignore": [
                "CVE-2025-64500",
                "CVE-2026-24765"
            ]
        },
        "preferred-install": {
            "wpstarter/framework": "source",
            "*": "auto"
        },
        "sort-packages": true
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php testbench package:purge-skeleton --ansi",
        "prepare": "@php testbench package:discover --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@clear",
            "@putenv PHP_CLI_SERVER_WORKERS=5",
            "@php testbench serve --ansi"
        ],
        "lint": [
            "@php vendor/bin/phpstan analyse --verbose"
        ],
        "test": [
            "@php vendor/bin/phpunit --no-coverage --no-configuration --bootstrap vendor/autoload.php --exclude-group phpunit-configuration --color tests"
        ],
        "sync": [
            "@clear",
            "@php bin/sync",
            "@lint"
        ],
        "sync-dev": [
            "@clear",
            "@php bin/sync --dev",
            "@lint"
        ],
        "ci": [
            "@composer audit",
            "@post-autoload-dump",
            "@lint",
            "@test"
        ]
    },
    "prefer-stable": true,
    "minimum-stability": "dev"
}
